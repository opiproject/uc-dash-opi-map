#
# Optional docker compose overrides. Site topology lives in config/lab.env.
# labctl setup-sonic exports OPI_SERVER_ADDRESS / OPI_SNAP_ADDRESS / ADAPTER_SO
# from lab.env — you do not need this file for the NVIDIA lab.
#
# Copy to deploy/.env only if you run `docker compose` by hand.

# Official sonic-buildimage tags, when available:
# SONIC_GNMI_IMAGE=docker-sonic-gnmi:latest
# SONIC_DASHORCH_IMAGE=docker-orchagent:latest
# SONIC_SYNCD_IMAGE=docker-syncd-vs:latest

# Host-built adapter (cmake --build build --target sai_opi_adapter)
ADAPTER_SO=../build/libsai_opi_adapter.so

# Prefer values from config/lab.env (DPU_IP:GRPC_PORT). These are compose fallbacks.
OPI_SERVER_ADDRESS=host.docker.internal:50051
OPI_SNAP_ADDRESS=host.docker.internal:50052
