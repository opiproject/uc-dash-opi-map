# Convenience KEY=VAL for tools that still look for opi.env.
# Source of truth is config/lab.env. labctl setup-sonic writes build/opi.env
# from DPU_IP + GRPC_PORT / SNAP_PORT. Do not point DASH at SNAP :50052.
#
OPI_SERVER_ADDRESS=172.22.3.2:50051
OPI_SNAP_ADDRESS=172.22.3.2:50052
